---
import '../styles/global.css';
import '../styles/polish.css';
import '../styles/navigation.css';
import '../styles/section-anchor.css';
import {ui,language} from '../i18n/ui.mjs';
const {title='G-Art Journey',description,lang='en'}=Astro.props;
const locale=language(lang), t=ui(locale);
const base=import.meta.env.BASE_URL;
const root=base; // English-first canonical URL. /en/ remains a legacy alias.
const href=(path='')=>root+path;
const current=Astro.url.pathname;
const relative=current.startsWith(base+'en/')?current.slice((base+'en/').length):current.slice(base.length);

const nav=[{href:'',label:t.nav.home},{href:'explore/',label:t.nav.explore},{href:'guides/',label:t.nav.guides},{href:'gallery/',label:t.nav.gallery}];
const active=(path)=>path==='guides/'?(relative==='guides/'||relative==='human-drawing/'||relative==='character-styles/'||relative.startsWith('guide/')||relative.startsWith('notes/')):path==='explore/'?(relative==='explore/'||relative.startsWith('artist/')||relative.startsWith('movement/')):path==='gallery/'?(relative==='gallery/'||relative==='my-art/'):relative===path;
const pageDescription=description||t.common.siteDescription;
---
<!doctype html>
<html lang={locale} data-base={base} data-theme="studio" style={`--playful-art: url("${base}decor/playful-paper.svg")`}>
 <head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f8f6f0" />
  <meta name="description" content={pageDescription} />
  <link rel="icon" type="image/svg+xml" href={base+'branding/g-art-mark.svg'}/>
  <link rel="canonical" href={new URL(base+relative,Astro.site).toString()}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Noto+Serif:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&display=swap" rel="stylesheet"/>
  <title>{title==='G-Art Journey'?title:title+' — G-Art Journey'}</title>
  <script is:inline>try{if(localStorage.getItem('g-art-theme')==='playful')document.documentElement.dataset.theme='playful';}catch{}</script>
 </head>
 <body>
  <a href="#main" class="skip-link">{locale==='vi'?'Đến nội dung chính':'Skip to content'}</a>
  <header class="site-header">
   <div class="site-shell nav-bar">
    <a class="brand" href={root} aria-label="G-Art Journey">
     <img class="brand-mark" src={base+'branding/g-art-mark.svg'} alt=""/>
     <span><span class="brand-name">G-Art Journey</span><span class="brand-sub">{locale==='vi'?'Khám phá · Cảm nhận · Sáng tạo':'Explore · Feel · Create'}</span></span>
    </a>
    <nav class="top-nav" aria-label={locale==='vi'?'Điều hướng chính':'Main navigation'}>
     {nav.map(n=><a href={href(n.href)} aria-current={active(n.href)?'page':undefined}>{n.label}</a>)}
    </nav>
    <details class="quick-explore">
      <summary aria-label={t.nav.quickHint}>✧ <span>{t.nav.quick}</span></summary>
      <nav aria-label={t.nav.quickHint}>
       <a href={href('explore/#materials')}>{t.nav.quickMaterials} ↗</a>
       <a href={href('explore/#movements')}>{t.nav.quickMovements} ↗</a>
       <a href={href('explore/#artists')}>{t.nav.quickArtists} ↗</a>
      </nav>
    </details>
    <button class="theme-toggle" type="button" data-theme-toggle aria-pressed="false" aria-label={locale==='vi'?'Bật giao diện vui tươi':'Switch to playful theme'}>✿ <span data-theme-label>{t.nav.themePlayful}</span></button>
    <details class="mobile-nav">
     <summary aria-label={locale==='vi'?'Mở menu điều hướng':'Open navigation menu'}>☰ <span>{t.nav.menu}</span></summary>
     <nav aria-label={locale==='vi'?'Điều hướng trên màn hình nhỏ':'Mobile navigation'}>
      {nav.map(n=><a href={href(n.href)} aria-current={active(n.href)?'page':undefined}>{n.label}</a>)}
      <div class="mobile-quick-title">{t.nav.quickHint}</div>
      <a href={href('explore/#materials')}>↳ {t.nav.quickMaterials}</a>
      <a href={href('explore/#movements')}>↳ {t.nav.quickMovements}</a>
      <a href={href('explore/#artists')}>↳ {t.nav.quickArtists}</a>
     </nav>
    </details>
   </div>
  </header>
  <main id="main"><slot /></main>
  <button type="button" class="back-to-top" data-back-to-top aria-label={t.nav.top} title={t.nav.top} hidden><span aria-hidden="true">↑</span></button>
  <footer class="footer"><div class="site-shell"><div class="footer-mark"><img class="brand-mark" src={base+'branding/g-art-mark.svg'} alt=""/><span>G-Art Journey · {t.common.footer}</span></div><span>{t.common.copyright} © {new Date().getFullYear()}</span></div></footer>
  <script define:vars={{themePlayful:t.nav.themePlayful,themeStudio:t.nav.themeStudio}}>
   const button=document.querySelector('[data-theme-toggle]'),label=document.querySelector('[data-theme-label]');
   const update=()=>{const playful=document.documentElement.dataset.theme==='playful';button?.setAttribute('aria-pressed',String(playful));if(label)label.textContent=playful?themeStudio:themePlayful;};
   update();
   button?.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='playful'?'studio':'playful';document.documentElement.dataset.theme=next;try{localStorage.setItem('g-art-theme',next)}catch{}update()});
   const top=document.querySelector('[data-back-to-top]');
   const updateTop=()=>{if(top)top.hidden=window.scrollY<480};
   updateTop();window.addEventListener('scroll',updateTop,{passive:true});
   top?.addEventListener('click',()=>window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth'}));
   document.addEventListener('click',e=>{for(const menu of document.querySelectorAll('details.quick-explore,details.mobile-nav')){if(!menu.contains(e.target))menu.open=false;}});
  </script>
 </body>
</html>