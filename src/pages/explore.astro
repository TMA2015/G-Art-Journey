---
import Base from '../layouts/Base.astro';
import SectionNav from '../components/SectionNav.astro';
import '../styles/discovery.css';
import {getMedia,getMovements,getArtists,getMoreArtists} from '../i18n/discovery.mjs';
import {ui,language} from '../i18n/ui.mjs';
const lang='en',t=ui(lang),base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const media=getMedia(lang),movements=getMovements(lang),artists=getArtists(lang),moreArtists=getMoreArtists(lang);
const sections=[{id:'materials',label:t.explore.materials},{id:'movements',label:t.explore.movements},{id:'artists',label:t.explore.artists}];
---
<Base lang={lang} title={t.nav.explore} description={t.explore.lead}>
<div class="site-shell">
 <header class="page-hero"><div class="topline eyebrow">{t.nav.explore}</div><h1 class="serif">{t.explore.title}</h1><p>{t.explore.lead}</p></header>
 <SectionNav lang={lang} items={sections}/>
 <section id="materials" class="discovery-section" aria-labelledby="materials-title">
  <div class="discovery-heading"><span class="eyebrow">{t.explore.materialsTag}</span><h2 id="materials-title" class="serif">{t.explore.materialsTitle}</h2><p>{t.explore.materialsIntro}</p></div>
  <div class="material-grid">
   {media.map((m,i)=><article class="material-card" id={m.id}><div class="material-image"><img src={base+m.image} alt={m.name} loading="lazy"/><span class="material-icon" aria-hidden="true">{m.emoji}</span></div><div class="material-copy"><span class="eyebrow">{String(i+1).padStart(2,'0')} / {m.label}</span><h3>{m.name}</h3><p>{m.text}</p><a href={url(m.start)}>{t.explore.materialsLink}</a></div></article>)}
  </div>
  <p class="discovery-note">{t.explore.materialsNote}</p>
 </section>
 <section id="movements" class="discovery-section" aria-labelledby="movements-title">
  <div class="discovery-heading"><span class="eyebrow">{t.explore.movementsTag}</span><h2 id="movements-title" class="serif">{t.explore.movementsTitle}</h2><p>{t.explore.movementsIntro}</p></div>
  <div class="movement-grid">
   {movements.map((m,i)=><a class="movement-card" href={url('movement/'+m.slug+'/')} style={'--movement-color:'+m.color}><div class="movement-image"><img src={base+m.image} alt={m.name} loading="lazy"/><span class="movement-index">{String(i+1).padStart(2,'0')} / 05</span></div><div class="movement-copy"><span class="eyebrow">{m.period}</span><h3 class="serif">{m.name} <span aria-hidden="true">↗</span></h3><p>{m.summary}</p></div></a>)}
  </div><p class="discovery-note">{t.explore.movementsNote}</p>
 </section>
 <section id="artists" class="discovery-section" aria-labelledby="artists-title">
  <div class="discovery-heading"><span class="eyebrow">{t.explore.artistsTag}</span><h2 id="artists-title" class="serif">{t.explore.artistsTitle}</h2><p>{t.explore.artistsIntro}</p></div>
  <div class="artist-grid">
   {artists.map(a=><a class="artist-card" href={url('artist/'+a.slug+'/')} style={'--artist-color:'+a.accent}><div class="artist-thumb"><img src={a.image.startsWith('https:')?a.image:base+a.image} alt={a.imageNote} loading="lazy" referrerpolicy="no-referrer"/></div><div class="artist-card-copy"><span class="eyebrow">{a.tag} · {a.dates}</span><h3 class="serif">{a.name} ↗</h3><p>{a.intro}</p><span class="artist-tag">{a.signature}</span></div></a>)}
  </div>
  <div class="artist-quick"><h3 class="serif">{t.explore.quickTitle}</h3><div class="artist-quick-grid">{moreArtists.map(a=><a href={a.url} target="_blank" rel="noopener noreferrer"><strong>{a.name} ↗</strong><span>{a.about}</span></a>)}</div></div>
  <p class="discovery-note">{t.explore.imageNote}</p>
 </section>
</div>
</Base>