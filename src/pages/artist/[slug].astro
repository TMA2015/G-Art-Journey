---
import '../../styles/discovery.css';
import Base from '../../layouts/Base.astro';
import {artists,movements} from '../../data/discovery.mjs';
export function getStaticPaths(){return artists.map(artist=>({params:{slug:artist.slug},props:{artist}}));}
const {artist}=Astro.props; const base=import.meta.env.BASE_URL;
---
<Base title={artist.name} description={artist.intro}>
 <article class="site-shell profile-page">
  <a href={base+'explore/#artists'} class="eyebrow back-link">← EXPLORE ART / ARTISTS</a>
  <header class="artist-infographic" style={'--artist-color:'+artist.accent}>
   <div class="infographic-art"><img src={artist.image.startsWith('https:')?artist.image:base+artist.image} alt={artist.imageNote} /><small>{artist.imageNote}</small></div>
   <div class="infographic-info">
    <span class="eyebrow">{artist.tag} · A LITTLE ART STORY</span>
    <h1 class="serif">{artist.name}</h1>
    <p class="infographic-dates">{artist.dates} · {artist.region}</p>
    <p class="infographic-intro">{artist.intro}</p>
    <div class="infographic-signature"><span>Hãy nhớ ba từ</span><strong>{artist.signature}</strong></div>
   </div>
  </header>
  <section class="infographic-detail">
   <div><span class="eyebrow">THREE LITTLE THINGS</span><h2 class="serif">Điều gì làm tranh thú vị?</h2></div>
   <div class="fact-list">{artist.facts.map((fact,i)=><div class="fact-row"><span>{String(i+1).padStart(2,'0')}</span><div><h3>{fact.name}</h3><p>{fact.detail}</p></div></div>)}</div>
  </section>
  <div class="infographic-panels">
   <section class="featured-work">
    <span class="eyebrow">ONE WORK TO SEE</span>
    <h2 class="serif">{artist.work}</h2><p>{artist.workYear} · {artist.museum}</p>
    <a href={artist.workUrl} target="_blank" rel="noopener noreferrer">Xem tác phẩm tại bảo tàng ↗</a>
   </section>
   <section class="try-art"><span class="eyebrow">TRY IT YOURSELF</span><h2 class="serif">Thử một nét nhỏ</h2><p>{artist.try}</p><a href={base+'guides/'}>Xem các bài hướng dẫn ↗</a></section>
  </div>
  <p class="discovery-note">Infographic do G-Art Journey biên soạn. Nguồn tác phẩm được liên kết trực tiếp với bảo tàng. Hình minh họa của website không được ghi là tác phẩm của nghệ sĩ.</p>
 </article>
</Base>