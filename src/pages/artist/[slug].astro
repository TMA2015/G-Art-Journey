---
import '../../styles/discovery.css';
import Base from '../../layouts/Base.astro';
import SectionNav from '../../components/SectionNav.astro';
import {artists} from '../../data/discovery.mjs';
import {getArtists} from '../../i18n/discovery.mjs';
export function getStaticPaths(){return artists.map(artist=>({params:{slug:artist.slug},props:{artist}}));}
const lang='en',base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const artist=getArtists(lang).find(a=>a.slug===Astro.props.artist.slug);
---
<Base lang={lang} title={artist.name} description={artist.intro}>
<article class="site-shell profile-page">
 <a href={url('explore/#artists')} class="eyebrow back-link">← Explore artists</a>
 <SectionNav lang={lang} items={[{id:'artist-about',label:'About'},{id:'artist-works',label:'Representative works'}]}/>

 <section id="artist-about" class="artist-infographic" style={'--artist-color:'+artist.accent}>
  <div class="infographic-art">
   <img src={artist.image.startsWith('https:')?artist.image:base+artist.image} alt={artist.imageNote||artist.name} referrerpolicy="no-referrer"/>
   <small>{artist.imageNote}</small>
  </div>
  <div class="infographic-info">
   <span class="eyebrow">ARTIST · {artist.region}</span>
   <h1 class="serif">{artist.name}</h1>
   <p class="infographic-dates">{artist.dates}</p>
   <p class="infographic-intro">{artist.intro}</p>
   <div class="infographic-signature"><span>Why this artist matters</span><strong>{artist.signature}</strong></div>
   <ul class="discovery-why">
    {artist.why.map(point=><li>{point}</li>)}
   </ul>
  </div>
 </section>

 <section id="artist-works" class="artwork-section">
  <div class="discovery-heading">
   <span class="eyebrow">LOOK AT THE ART</span>
   <h2 class="serif">Representative works</h2>
   <p>{artist.worksNote||'A small set of well-known works to help you recognize the artist’s ideas, choices and visual language.'}</p>
  </div>
  <div class="artwork-grid">
   {artist.artworks.map(work=>
    <article class="artwork-card">
     <a class="artwork-image" href={work.source} target="_blank" rel="noopener noreferrer">
      <img src={work.image} alt={work.title+' by '+work.artist} loading="lazy" referrerpolicy="no-referrer"/>
     </a>
     <div class="artwork-copy">
      <span class="eyebrow">{work.year}</span>
      <h3 class="serif">{work.title}</h3>
      <p class="artwork-by">{work.artist}</p>
      {work.museum&&<p class="artwork-museum">{work.museum}</p>}
      <p>{work.note}</p>
      <a class="artwork-source" href={work.source} target="_blank" rel="noopener noreferrer">Source · {work.rights} ↗</a>
     </div>
    </article>
   )}
  </div>
 </section>

 <p class="discovery-note">Artwork images on this page are used only when the linked source marks the file as public domain, CC0, or another open license. The source link is provided for provenance and license details.</p>
</article>
</Base>
