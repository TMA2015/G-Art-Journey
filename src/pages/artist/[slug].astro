---
import '../../styles/discovery.css';
import Base from '../../layouts/Base.astro';
import SectionNav from '../../components/SectionNav.astro';
import {artists} from '../../data/discovery.mjs';
import {getArtists} from '../../i18n/discovery.mjs';
import {ui,language} from '../../i18n/ui.mjs';
export function getStaticPaths(){return artists.map(artist=>({params:{slug:artist.slug},props:{artist}}));}
const lang=language(Astro.props.lang),t=ui(lang),base=import.meta.env.BASE_URL,url=(path='')=>base+(lang==='en'?'en/':'')+path;
const artist=getArtists(lang).find(a=>a.slug===Astro.props.artist.slug);
---
<Base lang={lang} title={artist.name} description={artist.intro}>
<article class="site-shell profile-page">
 <a href={url('explore/#artists')} class="eyebrow back-link">{t.artist.back}</a>
 <SectionNav lang={lang} items={[{id:'artist-intro',label:artist.name},{id:'artist-facts',label:t.artist.interesting},{id:'artist-work',label:t.artist.work},{id:'artist-try',label:t.artist.tryTitle}]}/>
 <header id="artist-intro" class="artist-infographic" style={'--artist-color:'+artist.accent}>
  <div class="infographic-art"><img src={artist.image.startsWith('https:')?artist.image:base+artist.image} alt={artist.imageNote}/><small>{artist.imageNote}</small></div>
  <div class="infographic-info"><span class="eyebrow">{artist.tag} · {t.artist.story}</span><h1 class="serif">{artist.name}</h1><p class="infographic-dates">{artist.dates} · {artist.region}</p><p class="infographic-intro">{artist.intro}</p><div class="infographic-signature"><span>{t.artist.threeWords}</span><strong>{artist.signature}</strong></div></div>
 </header>
 <section id="artist-facts" class="infographic-detail">
  <div><span class="eyebrow">{t.artist.three}</span><h2 class="serif">{t.artist.interesting}</h2></div>
  <div class="fact-list">{artist.facts.map((fact,i)=><div class="fact-row"><span>{String(i+1).padStart(2,'0')}</span><div><h3>{fact.name}</h3><p>{fact.detail}</p></div></div>)}</div>
 </section>
 <div class="infographic-panels">
  <section id="artist-work" class="featured-work"><span class="eyebrow">{t.artist.work}</span><h2 class="serif">{artist.work}</h2><p>{artist.workYear} · {artist.museum}</p><a href={artist.workUrl} target="_blank" rel="noopener noreferrer">{t.artist.view}</a></section>
  <section id="artist-try" class="try-art"><span class="eyebrow">{t.artist.try}</span><h2 class="serif">{t.artist.tryTitle}</h2><p>{artist.try}</p><a href={url('guides/')}>{t.artist.guides}</a></section>
 </div>
 <p class="discovery-note">{t.artist.disclaimer}</p>
</article>
</Base>