---
import Base from '../../layouts/Base.astro';
import { visualNotes } from '../../data/visual-notes.mjs';
import '../../styles/visual-notes.css';
export function getStaticPaths(){return visualNotes.map(note=>({params:{slug:note.slug},props:{note}}));}
const {note}=Astro.props;const base=import.meta.env.BASE_URL;
---
<Base title={note.title} description={note.description}>
<article class="site-shell visual-note-page">
<a href={base+'guides/'} class="eyebrow note-back">← DRAWING GUIDES</a>
<header class="note-heading"><span class="eyebrow">VISUAL NOTE {note.number} / {note.tag}</span><h1 class="serif">{note.title}</h1><p>{note.description}</p></header>
<figure class="visual-note-poster"><img src={base+note.image} alt={'Infographic '+note.subtitle} /><figcaption>Minh họa giáo dục nguyên bản của G-Art Journey.</figcaption></figure>
<div class="note-actions"><a href={base+note.image} target="_blank" rel="noopener">Mở hình lớn ↗</a><a href={base+note.image} download>Tải infographic SVG ↓</a><span>Thử vẽ: {note.time}</span></div>
<div class="note-body"><div><span class="eyebrow">JUST FIVE LITTLE STEPS</span><h2 class="serif">Thử làm theo từng bước</h2><p>Không cần vẽ giống hệt. Hãy chọn một ý bạn muốn thử trên giấy hoặc ứng dụng vẽ.</p></div><ol>{note.steps.map((s,i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></li>)}</ol></div>
<div class="note-footer"><strong>Một lưu ý nhỏ</strong><p>{note.note}</p><a href={base+'guides/'}>Khám phá thêm hướng dẫn ↗</a></div>
</article>
</Base>