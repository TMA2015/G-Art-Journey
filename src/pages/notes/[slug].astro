---
import Base from '../../layouts/Base.astro';
import SectionNav from '../../components/SectionNav.astro';
import {visualNotes} from '../../data/visual-notes.mjs';
import {getVisualNotes} from '../../i18n/notes.mjs';
import {ui,language} from '../../i18n/ui.mjs';
import '../../styles/visual-notes.css';
export function getStaticPaths(){return visualNotes.map(note=>({params:{slug:note.slug},props:{note}}));}
const lang='en',t=ui(lang),base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const note=getVisualNotes(lang).find(n=>n.slug===Astro.props.note.slug);
---
<Base lang={lang} title={note.title} description={note.description}>
 <article class="site-shell visual-note-page">
  <a href={url('guides/')} class="eyebrow note-back">{t.guides.back}</a>
  <header class="note-heading"><span class="eyebrow">{t.notes.titleSingle} {note.number} / {note.tag}</span><h1 class="serif">{note.title}</h1><p>{note.description}</p></header>
  {!note.retired&&<SectionNav lang={lang} items={[{id:'note-poster',label:t.notes.large},{id:'note-steps',label:t.notes.stepsTitle},{id:'note-tip',label:t.notes.smallNote}]}/>}
  {note.retired&&<section class="retired-note" aria-label="Updated illustrated guide">
   <span class="eyebrow">UPDATED DRAWING GUIDE</span>
   <h2 class="serif">{note.artPending?'A fresh illustrated version is on the way.':'Find the new illustrated lesson.'}</h2>
   <p>{note.artPending?'We are keeping the useful perspective steps, but have withdrawn the older drawing until its replacement meets our current art standard.':'This early diagram has been replaced by a clearer G-Art Journey poster with consistent drawing stages.'}</p>
   {!note.artPending&&<img src={base+note.image} alt={note.replacementTitle} loading="lazy"/>}
   <a class="hero-cta" href={url('guide/'+note.replacementGuide+'/')}>{note.artPending?'Read the perspective steps':'Open '+note.replacementTitle} ↗</a>
  </section>}
  {!note.retired&&<figure id="note-poster" class="visual-note-poster"><img src={base+note.image} alt={note.title}/><figcaption>{t.notes.caption}</figcaption></figure>}
  {!note.retired&&<div class="note-actions"><a href={base+note.image} target="_blank" rel="noopener">{t.notes.large}</a><a href={base+note.image} download>{t.notes.download}</a><span>{t.notes.practice}: {note.time}</span></div>}
  {!note.retired&&<div id="note-steps" class="note-body"><div><span class="eyebrow">{t.notes.five}</span><h2 class="serif">{t.notes.stepsTitle}</h2><p>{t.notes.stepsIntro}</p></div><ol>{note.steps.map((s,i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h3>{s.title}</h3><p>{s.body}</p></div></li>)}</ol></div>}
  {!note.retired&&<div id="note-tip" class="note-footer"><strong>{t.notes.smallNote}</strong><p>{note.note}</p><a href={url('guides/')}>{t.notes.more}</a></div>}
 </article>
</Base>