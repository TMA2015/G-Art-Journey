---
import '../../styles/discovery.css';
import Base from '../../layouts/Base.astro';
import SectionNav from '../../components/SectionNav.astro';
import {movements} from '../../data/discovery.mjs';
import {getMovements} from '../../i18n/discovery.mjs';
export function getStaticPaths(){return movements.map(movement=>({params:{slug:movement.slug},props:{movement}}));}
const lang='en',base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const movement=getMovements(lang).find(m=>m.slug===Astro.props.movement.slug);
---
<Base lang={lang} title={movement.name} description={movement.summary}>
<article class="site-shell movement-page">
 <a href={url('explore/#movements')} class="eyebrow back-link">← Explore art styles</a>
 <SectionNav lang={lang} items={[{id:'movement-about',label:'About'},{id:'movement-works',label:'Representative works'}]}/>

 <section id="movement-about" class="movement-hero" style={'--movement-color:'+movement.color}>
  <div class="movement-hero-copy">
   <span class="eyebrow">{movement.period}</span>
   <h1 class="serif">{movement.name}</h1>
   <p>{movement.summary}</p>
   <ul class="discovery-why">
    {movement.why.map(point=><li>{point}</li>)}
   </ul>
  </div>
  <div class="movement-hero-image">
   <img src={movement.image.startsWith('https:')?movement.image:base+movement.image} alt={movement.name} referrerpolicy="no-referrer"/>
   <small>Representative artwork · source and rights listed below</small>
  </div>
 </section>

 <section id="movement-works" class="artwork-section">
  <div class="discovery-heading">
   <span class="eyebrow">LOOK AT THE ART</span>
   <h2 class="serif">Representative works</h2>
   <p>These examples are not a complete history of the style. They are a compact set chosen to make its main visual ideas easier to recognize.</p>
  </div>
  <div class="artwork-grid">
   {movement.artworks.map(work=>
    <article class="artwork-card">
     <a class="artwork-image" href={work.source} target="_blank" rel="noopener noreferrer">
      <img src={work.image} alt={work.title+' by '+work.artist} loading="lazy" referrerpolicy="no-referrer"/>
     </a>
     <div class="artwork-copy">
      <span class="eyebrow">{work.year}</span>
      <h3 class="serif">{work.title}</h3>
      <p class="artwork-by">{work.artist}</p>
      {work.museum&&<p class="artwork-museum">{work.museum}</p>}
      <p>{work.note}</p>
      <a class="artwork-source" href={work.source} target="_blank" rel="noopener noreferrer">Source · {work.rights} ↗</a>
     </div>
    </article>
   )}
  </div>
 </section>

 <p class="discovery-note">Artwork images on this page are used only when the linked source marks the file as public domain, CC0, or another open license. Attribution alone is not treated as permission.</p>
</article>
</Base>
