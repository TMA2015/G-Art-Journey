---
import Base from '../layouts/Base.astro';
import '../styles/human-batch.css';
import '../styles/guide-series.css';
import {humanTopics} from '../data/guide-topics.mjs';
const base=import.meta.env.BASE_URL;
---
<Base lang="en" title="Human Drawing | Topic Library" description="Choose Faces & Head or Figure & Pose, then open the exact drawing lesson you want.">
<div class="site-shell human-library">
 <header class="page-hero human-hero">
  <div class="topline eyebrow">THE LITTLE SKETCHBOOK / HUMAN DRAWING</div>
  <h1 class="serif">Draw people, <em>one topic at a time.</em></h1>
  <p class="topic-hub-intro">Choose the kind of people-drawing practice you want first. Each topic opens its own smaller lesson shelf, so the nine guides stay easy to find.</p>
 </header>

 <section class="topic-hub-grid" aria-label="Human Drawing topics">
  {humanTopics.map(topic=><a class="topic-hub-card" href={base+'human-drawing/'+topic.id+'/'}>
   <div class="topic-hub-art"><img src={base+topic.image} alt={topic.label+' drawing topic'} loading="lazy" decoding="async"/></div>
   <div class="topic-hub-copy">
    <span class="eyebrow">{topic.eyebrow}</span>
    <h2 class="serif">{topic.label}</h2>
    <p>{topic.description}</p>
    <span class="topic-open">OPEN TOPIC ↗</span>
   </div>
  </a>)}
 </section>

 <p class="human-note">These examples are starting points, not fixed rules for age, gender or body proportions. Open a topic, choose a lesson and adapt the shapes to the person or character you want to draw.</p>
</div>
</Base>
