---
import Base from '../layouts/Base.astro';
import '../styles/guide-grid.css';
import '../styles/human-batch.css';
import '../styles/character-styles.css';
import '../styles/reference-library.css';
import SectionNav from '../components/SectionNav.astro';
import {getGuides} from '../i18n/content.mjs';
import {humanGuides} from '../data/human-guides.mjs';
import {characterGuides} from '../data/character-guides.mjs';
import {humanTopics,characterTopics} from '../data/guide-topics.mjs';
import {referenceItems,referenceStyles} from '../data/reference-library.mjs';
import {ui,language} from '../i18n/ui.mjs';
const lang='en',t=ui(lang),base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const groupedLessonSlugs=new Set([...humanGuides,...characterGuides].map(g=>g.slug));
const guides=getGuides(lang).filter(g=>!g.retired&&!g.artPending&&!groupedLessonSlugs.has(g.slug));
const naturalList=(labels=[])=>labels.length<=1?(labels[0]||''):labels.length===2?labels.join(' or '):labels.slice(0,-1).join(', ')+' or '+labels.at(-1);
const characterTopicLabels=characterTopics.map(x=>x.label);
const activeReferenceStyles=referenceStyles.filter(style=>style.id!=='all'&&referenceItems.some(item=>item.style===style.id));
const topicHubs=[
 {category:'figure',href:'human-drawing/',image:'infographics/human/face-basics.webp',tag:'HUMAN DRAWING',difficulty:'Topic library',title:'Human Drawing',description:'Choose '+naturalList(humanTopics.map(x=>x.label))+' before opening an individual lesson.',time:humanTopics.length+' topics · '+humanGuides.length+' lessons'},
 {category:'character',href:'character-styles/',image:'infographics/character/manga-face.webp',tag:'CHARACTER ART',difficulty:'Topic library',title:'Character Styles',description:'Choose '+naturalList(characterTopicLabels)+', then select the exact lesson you want.',time:characterTopics.length+' topics · '+characterGuides.length+' lessons'}
];
const categories=['figure','pencil','landscape','character','watercolor','digital'];
const filters=[{id:'all',label:t.guides.all},...categories.map(id=>({id,label:t.guides.categories[id]}))];
---
<Base lang={lang} title={t.nav.guides} description={t.guides.intro}>
 <div class="site-shell">
  <header class="page-hero"><div class="topline eyebrow">{t.guides.tag}</div><h1 class="serif">{t.guides.title1}<br/><em>{t.guides.title2}</em></h1><p>{t.guides.intro}</p></header>
  <SectionNav lang={lang} items={[{id:'human-guides',label:'Human Drawing'},{id:'character-styles',label:'Character Styles'},{id:'reference-library',label:'Reference Library'},{id:'guide-collection',label:t.guides.categoryLink}]}/>
  <section id="human-guides" class="human-preview" aria-labelledby="human-guides-heading">
    <div class="human-preview-copy"><span class="eyebrow">FEATURED / THE LITTLE SKETCHBOOK</span><h2 id="human-guides-heading" class="serif">Draw people, your way.</h2><p>{humanGuides.length} illustrated lessons across {humanTopics.length} topics for faces, expressions, head angles, body shapes and poses. Explore them at your own pace.</p><a class="hero-cta" href={url('human-drawing/')}>Explore {humanTopics.length} topics · {humanGuides.length} lessons ↗</a></div>
    <div class="human-preview-image"><img src={base+'infographics/human/face-basics.webp'} alt="Draw a face — one of eight original G-Art Journey posters" loading="lazy" width="1055" height="1491"/></div>
   </section>
   <p class="human-note">Want a quick pencil exercise? <a href={url('notes/graphite-values/')}>Explore light and shade ↗</a>. The older face, figure and perspective diagrams have been replaced or taken out of the main collection.</p>
  <section id="character-styles" class="character-preview" aria-labelledby="character-heading">
   <div class="character-preview-copy"><span class="eyebrow">FEATURED / A LITTLE CHARACTER STUDIO</span><h2 id="character-heading" class="serif">One pencil. Many worlds.</h2><p>{characterGuides.length} original illustrated lessons across {characterTopics.length} topics: {naturalList(characterTopicLabels)}. Each topic opens its own three-lesson shelf.</p><a class="hero-cta" href={url('character-styles/')}>Explore {characterTopics.length} topics · {characterGuides.length} lessons ↗</a></div>
   <div class="character-preview-image"><img src={base+'infographics/character/manga-variations.webp'} alt="Five original manga face variations" loading="lazy" width="1055" height="1491"/></div>
  </section>
  <section id="reference-library" class="reference-library-preview" aria-labelledby="reference-library-preview-heading">
   <div>
    <span class="eyebrow">NEW / VISUAL REFERENCE LIBRARY</span>
    <h2 id="reference-library-preview-heading" class="serif">Need a pose, hairstyle or outfit idea?</h2>
    <p>Browse {referenceItems.length} approved G-Art visual references for poses, movement, hair and clothing. Filter by {naturalList(activeReferenceStyles.map(x=>x.label))} when style matters.</p>
    <a class="hero-cta" href={url('reference-library/')}>Open the Reference Library ↗</a>
   </div>
   <div class="reference-preview-chips" aria-label="Reference Library collections">
    <span>Poses</span><span>Motion</span><span>Hair</span><span>Clothing</span>
   </div>
  </section>
  <section id="guide-collection" class="section" aria-labelledby="guides-heading" style="padding-top:40px">
   <div class="section-title-row"><div><span class="eyebrow">{t.guides.start}</span><h2 id="guides-heading" class="serif">{t.nav.guides}</h2></div></div>
   <nav class="guide-filters" data-guide-filters aria-label={t.guides.categoryLink}>
    {filters.map((f,i)=><button type="button" data-filter={f.id} aria-pressed={i===0?'true':'false'}>{f.label}</button>)}
   </nav>
   <div class="guide-grid guide-catalog" data-guide-catalog>
    {topicHubs.map(h=><a class="guide-card guide-anchor poster-card" data-category={h.category} href={url(h.href)}>
     <img src={base+h.image} alt={h.title+' topic library'} loading="lazy" decoding="async"/><div class="guide-body"><span class="guide-meta">{h.tag} · {h.difficulty}</span><h3>{h.title}</h3><p>{h.description}</p><div class="guide-bottom"><span>{h.time}</span><span>Open topic ↗</span></div></div>
    </a>)}
    {guides.map(g=><a class={"guide-card guide-anchor"+(g.poster?" poster-card":"")+(g.posterWide?" wide-poster-card":"")} id={guides.find(x=>x.category===g.category)?.slug===g.slug?g.category:undefined} data-category={g.category} href={url('guide/'+g.slug+'/')}>
     <img src={base+g.image} alt={g.posterAlt||g.title} loading="lazy" decoding="async"/><div class="guide-body"><span class="guide-meta">{g.tag} · {g.difficulty}</span><h3>{g.title}</h3><p>{g.description}</p><div class="guide-bottom"><span>{g.time}</span><span>{t.guides.open}</span></div></div>
    </a>)}
   </div>
   <p data-guide-empty hidden>{t.guides.empty}</p>
  </section>
  <div class="note-banner">{t.guides.note}</div>
 </div>
 <script>
  const buttons=[...document.querySelectorAll('[data-guide-filters] button')];
  const cards=[...document.querySelectorAll('[data-guide-catalog] [data-category]')];
  const empty=document.querySelector('[data-guide-empty]');
  const apply=value=>{let shown=0;for(const button of buttons)button.setAttribute('aria-pressed',String(button.dataset.filter===value));for(const card of cards){card.hidden=value!=='all'&&card.dataset.category!==value;if(!card.hidden)shown++;}if(empty)empty.hidden=shown!==0;};
  for(const button of buttons)button.addEventListener('click',()=>{apply(button.dataset.filter);});
  const target=location.hash.slice(1);if(buttons.some(b=>b.dataset.filter===target))apply(target);
 </script>
</Base>