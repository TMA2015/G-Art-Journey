---
import Base from '../../layouts/Base.astro';
import '../../styles/practical-guides.css';
import '../../styles/human-batch.css';
import '../../styles/guide-series.css';
import '../../styles/lesson-continuity.css';
import SectionNav from '../../components/SectionNav.astro';
import {guides} from '../../data/content.mjs';
import {digitalSeries} from '../../data/guide-topics.mjs';
import {getGuides} from '../../i18n/content.mjs';
import {getVisualNotes} from '../../i18n/notes.mjs';
import {ui} from '../../i18n/ui.mjs';
import {getGuideContinuity} from '../../data/learning-path-continuity.mjs';
export function getStaticPaths(){return guides.map(guide=>({params:{slug:guide.slug},props:{guide}}));}
const lang='en',t=ui(lang),base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const guide=getGuides(lang).find(g=>g.slug===Astro.props.guide.slug);
const series=digitalSeries[guide.slug];
const notes=getVisualNotes(lang);
const related=(guide.seeAlso||[]).map(slug=>notes.find(n=>n.slug===slug)).filter(Boolean);
const continuity=!guide.retired&&!series?getGuideContinuity(guide.slug):null;
const continuityPrimary=continuity?.primary;
const continuityPath=continuityPrimary?.path;
const continuityStage=continuityPrimary?.stage;
const continuityNext=continuity?.nextSlug?getGuides(lang).find(g=>g.slug===continuity.nextSlug):null;
const continuityPathHref=continuityPath?url('start-here/#'+continuityPath.id):url('start-here/');
const optionalMemberships=(continuity?.memberships||[]).filter(item=>item.role!=='core');
const optionalPathIds=[...new Set(optionalMemberships.map(item=>item.pathId))];
---
<Base lang={lang} title={guide.title} description={guide.description}>
 <article class="site-shell guide-article">
  <header class="page-hero"><a class="eyebrow" href={url('guides/')}>{t.guides.back} / {guide.tag}</a><h1 class="serif">{guide.title}</h1><p class="lead">{guide.description}</p></header>

  {guide.retired&&<section class="retired-note"><span class="eyebrow">UPDATED DRAWING GUIDE</span><h2 class="serif">Find the refreshed illustrated lesson.</h2><p>The original sketch has a clearer, more detailed guide in our latest collection.</p><a class="hero-cta" href={url('guide/'+guide.replacementGuide+'/')}>Open the updated lesson ↗</a></section>}

  {!guide.retired&&series&&<>
   <SectionNav lang={lang} items={[{id:'series-lessons',label:'Choose a lesson'}]}/>
   <section id="series-lessons" aria-label={guide.title+' lessons'}>
    <div class="topic-lesson-head">
     <div><span class="eyebrow">DIGITAL ART / TOPIC</span><h2 class="serif">Choose one lesson</h2><p>{series.description}</p></div>
    </div>
    <div class="lesson-choice-grid">
     {series.lessons.map((lesson,index)=>{
      const poster=guide.posterGallery?.[index];
      return poster&&<a class="series-lesson-card" href={url('guide/'+guide.slug+'/'+lesson.slug+'/')}>
       <div class="series-lesson-art"><img src={base+poster.image} alt={poster.alt||lesson.title} loading={index===0?'eager':'lazy'} decoding="async" width={poster.width} height={poster.height}/></div>
       <div class="series-lesson-copy">
        <span class="eyebrow">LESSON {String(index+1).padStart(2,'0')}</span>
        <h3 class="serif">{lesson.title}</h3>
        <p>{lesson.description}</p>
        <span class="topic-open">OPEN LESSON ↗</span>
       </div>
      </a>
     })}
    </div>
   </section>
   <p class="series-topic-note">Each poster now has its own lesson page. Open one lesson to read it at a comfortable size, use View large, save the approved WebP, then move to the previous or next lesson when you are ready.</p>
  </>}

  {!guide.retired&&!series&&<SectionNav lang={lang} items={guide.artPending?[{id:'guide-steps',label:t.guides.steps},{id:'guide-note',label:t.guides.guideNote}]:[{id:'guide-picture',label:t.common.illustration},{id:'guide-steps',label:t.guides.steps},{id:'guide-note',label:t.guides.guideNote}]}/>}

  {!guide.retired&&!series&&!guide.artPending&&(guide.posterGallery?.length?
   <section id="guide-picture" class="guide-poster-gallery" aria-label={guide.title+' illustrations'}>
    {guide.posterGallery.map((poster,index)=>
      <figure class:list={['guide-poster',poster.wide&&'guide-poster-wide']}>
       <img src={base+poster.image} alt={poster.alt||poster.title} fetchpriority={index===0?'high':'auto'} loading={index===0?'eager':'lazy'} width={poster.width} height={poster.height}/>
       <figcaption><span>{poster.title} · Original G-Art Journey illustration</span>
        <span class="guide-poster-actions"><a href={base+poster.image} target="_blank" rel="noopener">View large ↗</a><a href={base+poster.image} download>Save WebP ↓</a></span>
       </figcaption>
      </figure>
    )}
   </section>:
   guide.poster?
   <figure id="guide-picture" class="guide-poster">
    <img src={base+guide.image} alt={guide.posterAlt||guide.title} fetchpriority="high" width={guide.posterWidth||1122} height={guide.posterHeight||1402}/>
    <figcaption><span>Original G-Art Journey illustration · {guide.title}</span>
     <span class="guide-poster-actions"><a href={base+guide.image} target="_blank" rel="noopener">View large ↗</a><a href={base+guide.image} download>Save WebP ↓</a></span>
    </figcaption>
   </figure>:
   <img id="guide-picture" class="guide-cover" src={base+guide.image} alt={guide.title}/>
  )}

  {!guide.retired&&!series&&guide.artPending&&<section class="pending-art-note"><span class="eyebrow">PENCIL LANDSCAPE / NOTES</span><h2 class="serif">A new illustrated poster is being prepared.</h2><p>The practical perspective steps remain available below.</p></section>}

  {!guide.retired&&!series&&<div class="lesson-grid">
   <aside class="lesson-sidebar"><span class="eyebrow">{t.guides.guideNote}</span><p>{t.guides.suggestedTime}: {guide.time}</p><p>{t.guides.supplies}: {guide.supplies}</p><p>{t.guides.free}</p><a class="subtle-link" href={url('guides/')}>{t.guides.back}</a></aside>
   <div id="guide-steps"><span class="eyebrow">{t.guides.steps}</span><ol class="lesson-steps">{guide.steps.map(step=><li><div><h3>{step.title}</h3><p>{step.body}</p></div></li>)}</ol><div id="guide-note" class="note-banner">{guide.artPending?'These drawing steps stay available while the new illustrated poster is prepared.':guide.poster?'The poster uses one friendly illustrated approach. Compare real references and adjust the shapes to suit your subject.':guide.image.startsWith('infographics/')?'This original diagram shows the main drawing idea. Use the steps above to try it yourself.':t.guides.placeholder}</div></div>
  </div>}

  {!guide.retired&&!series&&(guide.tryIt||guide.remember||related.length>0)&&<section class="practice-followup" aria-label="Try it yourself">
   {guide.tryIt&&<div class="practice-challenge"><span class="eyebrow">A LITTLE DRAWING CHALLENGE</span><h2 class="serif">Make it your own</h2><p>{guide.tryIt}</p></div>}
   {guide.remember&&<div class="practice-reminder"><span class="eyebrow">KEEP IN MIND</span><p>{guide.remember}</p></div>}
   {related.length>0&&<div class="practice-related"><span class="eyebrow">LOOK AT A VISUAL NOTE</span><div>{related.map(note=><a href={note.retired?url('guide/'+note.replacementGuide+'/'):url('notes/'+note.slug+'/')}>{note.retired?note.replacementTitle:note.title} ↗</a>)}</div></div>}
  </section>}
  {continuity&&<section class="learning-continuity" aria-label="Continue learning">
   <span class="eyebrow">{continuityPrimary.role==='core'?'CONTINUE LEARNING':'WHERE THIS FITS'}</span>
   <h2 class="serif">{continuityPrimary.role==='core'?'Keep going with '+continuityPath.title:'Use this lesson when you need it'}</h2>
   {continuityPrimary.role==='core'?
    <p>This lesson is part of <strong>{continuityPath.title}</strong>{continuityStage?<> · {continuityStage.label}</>:''}. The path is suggested, not locked—you can jump anywhere at any time.</p>:
    <p>This is an optional support lesson. Use it when it helps your current drawing rather than treating it as a required checkpoint.</p>}
   <div class="learning-continuity-meta">
    {continuityPrimary.role==='core'&&<a href={continuityPathHref}>{continuityPath.title}{continuityStage?' · '+continuityStage.label:''}</a>}
    {optionalMemberships.map(item=><a href={url('start-here/#'+item.pathId)}>{item.role==='support'?'Support':'Explore more'} · {item.pathTitle}{item.group?' · '+item.group:''}</a>)}
   </div>

   {continuityPrimary.role==='core'&&continuityNext?<div class="learning-continuity-actions">
    <a class="learning-continuity-card" href={url('guide/'+continuityNext.slug+'/')}>
     <span>Next suggested lesson →</span>
     <strong>{continuityNext.title}</strong>
     <p>{continuityNext.description}</p>
    </a>
    <a class="learning-continuity-card" href={continuityPathHref}>
     <span>Back to path</span>
     <strong>{continuityPath.title}</strong>
     <p>See the whole suggested route and choose any lesson.</p>
    </a>
   </div>:
   continuityPrimary.role==='core'?<div class="learning-continuity-actions">
    <a class="learning-continuity-card" href={continuityPathHref}>
     <span>Path checkpoint</span>
     <strong>Back to {continuityPath.title}</strong>
     <p>You reached the end of this core sequence. Explore optional lessons or choose another path.</p>
    </a>
    <a class="learning-continuity-card" href={url('start-here/#choose-a-path')}>
     <span>Choose another path</span>
     <strong>What would you like to draw next?</strong>
     <p>Switch direction without losing access to anything.</p>
    </a>
   </div>:
   <div class="learning-continuity-actions">
    {optionalPathIds.slice(0,2).map(pathId=>{
     const item=optionalMemberships.find(m=>m.pathId===pathId);
     return item&&<a class="learning-continuity-card" href={url('start-here/#'+pathId)}>
      <span>{item.role==='support'?'Support in':'Explore more in'}</span>
      <strong>{item.pathTitle}</strong>
      <p>{item.group?'Look under '+item.group+'.':'Return to the path and choose what you need next.'}</p>
     </a>
    })}
   </div>}
  </section>}
 </article>
</Base>