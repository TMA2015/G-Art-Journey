---
import Base from '../layouts/Base.astro';
import artwork from '../data/gallery.generated.json';
import {ui,language} from '../i18n/ui.mjs';
const lang=language(Astro.props.lang),t=ui(lang),base=import.meta.env.BASE_URL;
const ownerLabels=t.gallery.owners;
const translateArtwork=(item,key)=>item[key+'_'+lang]||item[key];
---
<Base lang={lang} title={t.nav.gallery} description={t.gallery.intro}>
 <div class="site-shell">
  <header class="page-hero"><div class="topline eyebrow">{t.nav.gallery}</div><h1 class="serif">{t.gallery.title}</h1><p>{t.gallery.intro}</p></header>
  {artwork.length>0 ? <>
   <div class="gallery-filters" aria-label={t.gallery.filterLabel}>
    {['all','daughter','dad','shared'].map((key,i)=><button type="button" data-gallery-filter={key} aria-pressed={i===0?'true':'false'}>{t.gallery.filters[key]}</button>)}
   </div>
   <div class="personal-grid">{artwork.map(item=><figure class="personal-item" data-owner={item.owner}><a href={base+item.src} target="_blank" rel="noopener" aria-label={t.gallery.openImage+': '+translateArtwork(item,'title')}><img src={base+item.src} alt={translateArtwork(item,'title')} loading="lazy"/></a><figcaption><span class="eyebrow">{ownerLabels[item.owner]||t.nav.gallery} {item.medium?' · '+translateArtwork(item,'medium'):''}</span><h2>{translateArtwork(item,'title')}</h2>{item.note&&<p>{translateArtwork(item,'note')}</p>}{item.date&&<p>{item.date}</p>}</figcaption></figure>)}</div>
   <p data-no-matches hidden>{t.gallery.emptyFilter}</p>
  </>:
  <div class="empty-gallery"><span class="eyebrow">{t.gallery.emptyTag}</span><h2>{t.gallery.emptyTitle}</h2><p>{t.gallery.emptyIntro}</p><a href="https://github.com/TMA2015/G-Art-Journey/tree/main/public/artworks" target="_blank" rel="noopener">{t.gallery.folder}</a></div>}
  <div class="note-banner">{t.gallery.warning}</div>
 </div>
 <script>
  const buttons=[...document.querySelectorAll('[data-gallery-filter]')],cards=[...document.querySelectorAll('[data-owner]')],empty=document.querySelector('[data-no-matches]');
  for(const button of buttons)button.addEventListener('click',()=>{const value=button.dataset.galleryFilter;for(const b of buttons)b.setAttribute('aria-pressed',String(b===button));let visible=0;for(const card of cards){const show=value==='all'||card.dataset.owner===value;card.hidden=!show;if(show)visible++}if(empty)empty.hidden=visible!==0;});
 </script>
</Base>