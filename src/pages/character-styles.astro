---
import Base from '../layouts/Base.astro';
import '../styles/character-styles.css';
import '../styles/guide-series.css';
import {characterTopics} from '../data/guide-topics.mjs';
import {guides} from '../data/content.mjs';
const base=import.meta.env.BASE_URL;
const lab=guides.find(g=>g.slug==='four-character-face-approaches');
---
<Base lang="en" title="Character Art | Topic Library" description="Choose a character-art topic first, then open the exact lesson you want: manga, webtoon, manhua, cartoon, chibi, fairy-tale princess or the Character Face Design Lab.">
 <div class="site-shell character-library">
  <header class="page-hero character-hero">
   <span class="eyebrow">A LITTLE CHARACTER STUDIO</span>
   <h1 class="serif">Choose a character <em>topic.</em></h1>
   <p class="topic-hub-intro">Start with the kind of character work you want to explore: manga, manhwa / webtoon, manhua, cartoon / comics, chibi or fairy-tale princess design. Each topic opens its own three-lesson shelf.</p>
  </header>

  <section class="topic-hub-grid" aria-label="Character Art topics">
   {characterTopics.map(topic=><a class="topic-hub-card" href={base+'character-styles/'+topic.id+'/'}>
    <div class="topic-hub-art"><img src={base+topic.image} alt={topic.label+' character art topic'} loading="lazy" decoding="async"/></div>
    <div class="topic-hub-copy">
     <span class="eyebrow">{topic.eyebrow}</span>
     <h2 class="serif">{topic.label}</h2>
     <p>{topic.description}</p>
     <span class="topic-open">OPEN TOPIC ↗</span>
    </div>
   </a>)}
   {lab&&<a class="topic-hub-card topic-hub-wide" href={base+'guide/'+lab.slug+'/'}>
    <div class="topic-hub-art"><img src={base+lab.image} alt={lab.posterAlt||lab.title} loading="lazy" decoding="async"/></div>
    <div class="topic-hub-copy">
     <span class="eyebrow">CHARACTER DESIGN LAB</span>
     <h2 class="serif">{lab.title}</h2>
     <p>{lab.description}</p>
     <span class="topic-open">OPEN THE DESIGN LAB ↗</span>
    </div>
   </a>}
  </section>

  <p class="character-note">These are original learning collections, not fixed rules. Manga, manhwa / webtoon, manhua and cartoon / comics are broad visual families; chibi and fairy-tale princess are character-design themes. Open one topic, choose one lesson, and adapt the ideas to your own characters.</p>
 </div>
</Base>
