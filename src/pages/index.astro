---
import Base from '../layouts/Base.astro';
import SectionNav from '../components/SectionNav.astro';
import '../styles/human-batch.css';
import {getHomeShowcase,getGuides} from '../i18n/content.mjs';
import {artists as exploreArtists,movements as exploreMovements,media as exploreMedia} from '../data/discovery.mjs';
import {daughterArt} from '../data/daughter-art.mjs';
import {ui,language} from '../i18n/ui.mjs';
const lang='en',t=ui(lang),base=import.meta.env.BASE_URL,url=(path='')=>base+path;
const showcase=getHomeShowcase(lang),guides=getGuides(lang),first=showcase[0];
const jump=[{id:'collections',label:t.home.collections},{id:'drawing-guides',label:t.home.guideTitle},{id:'family-gallery',label:t.nav.gallery}];
const featuredGuides=['face-basics','figure-proportions','standing-figure'].map(slug=>guides.find(g=>g.slug===slug));
const leonardo=exploreArtists.find(item=>item.slug==='leonardo-da-vinci');
const postImpressionism=exploreMovements.find(item=>item.slug==='post-impressionism');
const watercolor=exploreMedia.find(item=>item.id==='watercolor');
const blueRigi=watercolor?.examples?.find(item=>item.title==='The Blue Rigi, Sunrise')||watercolor?.examples?.[0];
const discoverCards=[
 {number:'01',title:'Artists',subtitle:'Artist stories',description:'Meet artists through their works, ideas and visual language.',image:leonardo?.image,alt:leonardo?.imageNote||'Artwork from the Leonardo da Vinci artist story',link:'explore/#artists'},
 {number:'02',title:'Styles & Movements',subtitle:'Art movements',description:'See how different periods and movements change color, space, rhythm and form.',image:postImpressionism?.image,alt:'The Starry Night by Vincent van Gogh',link:'explore/#movements'},
 {number:'03',title:'Materials',subtitle:'Ways to make art',description:'Explore graphite, watercolor, paint, ink and other materials through real examples.',image:blueRigi?.image,alt:'The Blue Rigi, Sunrise by J. M. W. Turner',link:'explore/#materials'}
].filter(item=>item.image);
const galleryArt=['07','09'].map(id=>daughterArt.find(item=>item.legacyId===id)).filter(Boolean);
const imageSrc=(src='')=>src.startsWith('https:')?src:base+src;
---
<Base lang={lang} title="G-Art Journey" description={t.common.siteDescription}>
 <div class="site-shell">
  <section class="hero" data-hero aria-label={t.home.today}>
   <div class="hero-visual">
    <a class="hero-visual-link" data-hero-image-link href={url(first.images[0].href||first.href)}>
     <img data-hero-image data-fit={first.images[0].fit||'cover'} src={base+first.images[0].src} alt={first.images[0].alt} fetchpriority="high"/>
    </a>
    <div class="hero-caption"><span data-hero-caption>{first.images[0].caption||first.images[0].title+' · '+t.home.illustration}</span><span data-hero-source>{first.sourceLabel}</span></div>
   </div>
   <div class="hero-copy">
    <span class="eyebrow" data-hero-label>{t.home.today}</span>
    <h1 class="serif" data-hero-title>{first.title}</h1>
    <p data-hero-description>{first.description}</p>
    <a class="hero-cta" data-hero-cta href={url(first.href)}>{first.cta||t.home.cta}</a>
    <div class="hero-controls">
     <span class="count" data-hero-count>01 / 02</span>
     <label class="visually-hidden" for="style-picker">{t.home.style}</label>
     <select class="style-select" id="style-picker" data-style-select>
      {showcase.map(s=><option value={s.id}>{s.label}</option>)}
     </select>
     <button type="button" data-prev aria-label={t.home.prev}>←</button>
     <button type="button" data-next aria-label={t.home.next}>→</button>
     <button type="button" data-pause aria-label={t.home.pause} aria-pressed="false">Ⅱ</button>
    </div>
   </div>
  </section>
  <div class="intro-strip"><h2 class="serif">{t.home.intro1}<br/><em>{t.home.intro2}</em></h2><p>{t.home.introDesc}</p></div>
  <SectionNav lang={lang} items={jump}/>
  <section id="collections" class="section" aria-labelledby="collections-heading">
   <div class="section-title-row"><div><span class="eyebrow">{t.home.discover}</span><h2 class="serif" id="collections-heading">{t.home.collections}</h2></div><a class="subtle-link" href={url('explore/')}>{t.home.allCollections}</a></div>
   <div class="collection-grid home-explore-grid">
    {discoverCards.map(item=><a class="collection-card home-explore-card" href={url(item.link)}>
      <div class="art-frame">
       <img src={imageSrc(item.image)} alt={item.alt} loading="lazy" decoding="async" referrerpolicy={item.image.startsWith('https:')?'no-referrer':undefined}/>
      </div>
      <div class="meta"><span>{item.number} / {item.subtitle}</span></div>
      <h3>{item.title}</h3>
      <p>{item.description}</p>
      <span class="arrow" aria-hidden="true">↗</span>
     </a>)}
   </div>
  </section>
  <section class="editorial-banner">
   <div class="banner-art"><img src={base+(lang==='en'?'showcase/pencil-landscape-2.svg':'showcase/vi/pencil-landscape-2.svg')} alt={lang==='vi'?'Phác thảo đường phố bằng chì':'Pencil illustration of a little street'} loading="lazy"/></div>
   <div class="banner-text"><span class="eyebrow">{t.home.sketchTag}</span><h2 class="serif">{t.home.sketchTitle}</h2><p>{t.home.sketchDesc}</p><a class="subtle-link" href={url('guides/#landscape')}>{t.home.sketchCTA}</a></div>
  </section>
  <section id="drawing-guides" class="section" aria-labelledby="guides-heading">
   <div class="section-title-row"><div><span class="eyebrow">{t.home.guideTag}</span><h2 class="serif" id="guides-heading">{t.home.guideTitle}</h2></div><a class="subtle-link" href={url('human-drawing/')}>Explore Human Drawing ↗</a></div>
   <div class="guide-grid home-approved-guides">{featuredGuides.map(g=><a class="guide-card poster-card" href={url('guide/'+g.slug+'/')}><div class="home-guide-media"><img src={base+g.image} alt={g.posterAlt||g.title} loading="lazy" decoding="async" width={g.posterWidth||1122} height={g.posterHeight||1402}/></div><div class="guide-body"><span class="guide-meta">{g.tag} · {g.difficulty}</span><h3>{g.title}</h3><p>{g.description}</p><div class="guide-bottom"><span>{g.time}</span><span>{t.home.openGuide}</span></div></div></a>)}</div>
  </section>

 </div>
 <section id="family-gallery" class="gallery-preview"><div class="site-shell"><div><span class="eyebrow">{t.home.galleryTag}</span><h2 class="serif">{t.home.galleryTitle}</h2><p>{t.home.galleryDesc}</p><a class="hero-cta" href={url('gallery/')}>{t.home.galleryLink}</a></div><div class="gallery-art">{galleryArt.map(item=><img src={base+item.src} alt={item.title+' · '+item.medium} loading="lazy" decoding="async" width="900" height="1200"/>)}</div></div></section>
 <script>import '../scripts/home.js';</script>
</Base>