{
  "name": "g-art-journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-gallery.mjs && astro dev",
    "build": "node scripts/build-gallery.mjs && astro build",
    "preview": "astro preview",
    "test": "node --test tests/*.test.mjs",
    "audit:assets": "node scripts/check-assets.mjs",
    "art:prepare": "node scripts/art-batch.mjs",
    "art:check": "node scripts/art-batch.mjs --check",
    "audit:guides": "node scripts/check-guide-overlap.mjs",
    "core:assets": "node scripts/build-core-assets.mjs",
    "pretest": "npm run core:assets && npm run materials:assets",
    "prebuild": "npm run core:assets && npm run materials:assets",
    "predev": "npm run core:assets && npm run materials:assets",
    "materials:assets": "node scripts/build-material-assets.mjs"
  },
  "dependencies": {
    "astro": "^5.0.0",
    "sharp": "^0.34.4"
  }
}
